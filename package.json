{
  "name": "@tangent.to/mc",
  "version": "0.9.1",
  "description": "JavaScript Markov Chain Monte Carlo - A PyMC-inspired probabilistic programming library for Bayesian inference in JavaScript",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "browser": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./persistence": "./src/utils/persistence.js"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepare": "npm run build:browser",
    "build:browser": "esbuild src/index.js --bundle --platform=browser --format=esm --target=es2020 --outfile=dist/index.js --sourcemap --minify --keep-names --external:@tangent.to/*",
    "watch": "esbuild src/index.js --bundle --platform=browser --format=esm --target=es2020 --outfile=dist/index.js --sourcemap --keep-names --watch --external:@tangent.to/*",
    "jsr:publish": "deno publish --allow-dirty",
    "jsr:publish:dry-run": "deno publish --dry-run --allow-dirty",
    "test": "vitest",
    "test:pymc": "node tests/pymc-comparison.js",
    "test:all": "npm run test:run && npm run test:pymc",
    "example": "node examples/linear_regression.js",
    "example:all": "node examples/linear_regression.js && node examples/logistic_regression.js && node examples/hierarchical_model.js",
    "docs:api": "node scripts/build-api-docs.mjs",
    "docs:generate": "node scripts/generate-docs.js",
    "docs:serve": "node scripts/serve-docs.js",
    "prepublishOnly": "npm run test:run",
    "test:run": "vitest run",
    "deno:check": "deno check src/index.js",
    "version": "node scripts/sync-version.mjs && git add deno.json"
  },
  "keywords": [
    "bayesian",
    "mcmc",
    "probabilistic-programming",
    "statistics",
    "inference",
    "pymc",
    "bayesian-inference",
    "machine-learning",
    "tensorflow",
    "browser",
    "observable",
    "tangent.to"
  ],
  "author": "Essi Parent",
  "license": "GPL-3.0",
  "devDependencies": {
    "esbuild": "^0.25.11",
    "typedoc": "^0.28.0",
    "typedoc-plugin-markdown": "^4.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tangent-to/mc.git"
  },
  "bugs": {
    "url": "https://github.com/tangent-to/mc/issues"
  },
  "homepage": "https://github.com/tangent-to/mc#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@tangent.to/grad": "^0.1.3",
    "@tangent.to/proba": "^0.1.0"
  }
}
